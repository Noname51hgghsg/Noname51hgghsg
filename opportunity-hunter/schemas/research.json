{
 "type": "object",
 "properties": {
  "results": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "candidate_id": {
      "type": "string"
     },
     "answers": {
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "question": {
         "type": "string"
        },
        "finding": {
         "type": "string",
         "enum": [
          "FOUND",
          "PARTIAL",
          "NO_RELIABLE_EVIDENCE_FOUND"
         ]
        },
        "answer": {
         "type": "string"
        },
        "sources": {
         "type": "array",
         "items": {
          "type": "object",
          "properties": {
           "url": {
            "type": "string"
           },
           "title": {
            "type": "string"
           }
          },
          "required": [
           "url",
           "title"
          ]
         }
        }
       },
       "required": [
        "question",
        "finding",
        "answer",
        "sources"
       ]
      }
     }
    },
    "required": [
