{
 "type": "object",
 "properties": {
  "results": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "candidate_id": {
      "type": "string"
     },
     "verdict": {
      "type": "string",
      "enum": [
       "SURVIVED",
       "REJECTED",
       "NEEDS_MORE_EVIDENCE"
      ]
     },
     "kill_reasons": {
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "category": {
         "type": "string",
         "enum": [
          "STRONG_COMPETITOR",
          "NO_WILLINGNESS_TO_PAY",
          "SMALL_MARKET",
          "HIGH_CAC",
          "HARD_CUSTOMER_ACCESS",
          "REGULATORY",
          "TECHNICAL",
          "DATA_UNAVAILABLE",
          "PARTNERSHIP_DEPENDENCY",
          "WEAK_PAIN",
          "FOUNDER_MISFIT",
          "OTHER"
         ]
        },
        "reason": {
         "type": "string"
        },
        "severity": {
         "type": "string",
         "enum": [
          "FATAL",
          "MAJOR",
          "MINOR"
         ]
        },
        "evidence": {
         "type": "array",
         "items": {
          "type": "object",
          "properties": {
           "url": {
            "type": "string"
           },
           "summary": {
            "type": "string"
           }
          },
          "required": [
           "url",
           "summary"
          ]
         }
        }
       },
       "required": [
        "category",
        "reason",
        "severity",
        "evidence"
       ]
      }
     },
     "attacks_attempted": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "remaining_uncertainties": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "missing_info_requests": {
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "question": {
         "type": "string"
        },
        "route_to": {
         "type": "string",
         "enum": [
          "payment",
          "competition",
          "evidence",
          "regulatory",
          "market",
          "technical"
         ]
        }
       },
       "required": [
        "question",
        "route_to"
       ]
      }
     },
     "survival_notes": {
      "type": "string"
     },
     "summary": {
      "type": "string"
     }
    },
    "required": [
     "candidate_id",
     "verdict",
     "kill_reasons",
     "attacks_attempted",
     "remaining_uncertainties",
     "missing_info_requests",
     "survival_notes",
     "summary"
    ]
   }
  },
  "queries_used": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "limitations": {
   "type": "array",
   "items": {
    "type": "string"
   }
  }
 },
 "required": [
  "results",
  "queries_used",
  "limitations"
 ],
 "$schema": "http://json-schema.org/draft-07/schema#"
}